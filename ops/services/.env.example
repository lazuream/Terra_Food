# Existing infrastructure. For Docker Desktop, host.docker.internal reaches the host.
DB_URL=jdbc:mysql://host.docker.internal:3306/dayan_food?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=replace_me
DB_PASSWORD=replace_me
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace_me
# Absolute path to the EXISTING uploads directory; runtime UID 10001 needs write access.
UPLOAD_DIRECTORY=D:/work/code/DY/Terra_Food/dayanfood-backend/uploads
GATEWAY_PORT=8080
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://your-web.example.com
SERVICE_SUBNET=172.30.92.0/24
TRUSTED_PROXY_CIDRS=172.30.92.0/24
# Configure the existing Python agent separately when AI features are needed.
AGENT_SERVICE_URL=http://host.docker.internal:8090
AGENT_INTERNAL_TOKEN=
MCP_BACKEND_TOKEN=
AGENT_CONTEXT_SECRET=

# Generate a random token (at least 32 characters) and share it only between backend services.
USER_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-characters
