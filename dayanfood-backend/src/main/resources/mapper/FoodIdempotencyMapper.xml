<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dayan.food.mapper.FoodIdempotencyMapper">
 <select id="findFoodId" resultType="long">SELECT food_id FROM food_create_idempotency WHERE user_id=#{userId} AND idem_key=#{key}</select>
 <insert id="insert">INSERT INTO food_create_idempotency(user_id,idem_key,food_id) VALUES(#{userId},#{key},#{foodId})</insert>
</mapper>
