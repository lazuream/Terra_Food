<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dayan.food.mapper.FoodCheckinMapper">
  <resultMap id="checkin" type="com.dayan.food.entity.po.FoodCheckin">
    <id property="id" column="id"/><result property="foodId" column="food_id"/>
    <result property="userId" column="user_id"/>
    <result property="foodName" column="food_name_snapshot"/><result property="eatenOn" column="eaten_on"/>
    <result property="note" column="note"/><result property="visibility" column="visibility"/>
    <result property="commentId" column="comment_id"/><result property="timezone" column="timezone"/>
    <result property="version" column="version"/>
    <result property="createdAt" column="created_at"/><result property="updatedAt" column="updated_at"/>
  </resultMap>
  <sql id="columns">id, food_id, user_id, food_name_snapshot, eaten_on, note, visibility, comment_id, timezone, version, created_at, updated_at</sql>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    INSERT INTO food_checkin(food_id,user_id,food_name_snapshot,eaten_on,note,visibility,comment_id,timezone,version,created_at,updated_at)
    VALUES(#{foodId},#{userId},#{foodName},#{eatenOn},#{note},#{visibility},#{commentId},#{timezone},#{version},#{createdAt},#{updatedAt})
  </insert>
  <sql id="userFilters">user_id=#{userId}<if test="visibility != null"> AND visibility=#{visibility}</if><if test="from != null"> AND eaten_on &gt;= #{from}</if><if test="to != null"> AND eaten_on &lt;= #{to}</if></sql>
  <select id="findByUser" resultMap="checkin">SELECT <include refid="columns"/> FROM food_checkin WHERE <include refid="userFilters"/> ORDER BY eaten_on DESC,id DESC LIMIT #{limit} OFFSET #{offset}</select>
  <select id="countByUser" resultType="int">SELECT COUNT(*) FROM food_checkin WHERE <include refid="userFilters"/></select>
  <select id="findOwned" resultMap="checkin">SELECT <include refid="columns"/> FROM food_checkin WHERE id=#{id} AND user_id=#{userId}</select>
  <update id="updateOwned">UPDATE food_checkin SET eaten_on=#{eatenOn},note=#{note},visibility=#{visibility},comment_id=#{commentId},timezone=#{timezone},version=version+1,updated_at=CURRENT_TIMESTAMP WHERE id=#{id} AND user_id=#{userId} AND version=#{version}</update>
  <delete id="deleteOwned">DELETE FROM food_checkin WHERE id=#{id} AND user_id=#{userId}</delete>
</mapper>
