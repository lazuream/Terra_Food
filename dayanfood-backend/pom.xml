<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.dayan</groupId>
    <artifactId>dayanfood-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>大炎珍馐志 - Backend</name>

    <modules>
        <module>food-common</module>
        <module>food-platform</module>
        <module>food-user</module>
        <module>food-catalog</module>
        <module>food-achievement</module>
        <module>food-community</module>
        <module>food-media</module>
        <module>food-agent</module>
        <module>food-boot</module>
        <module>food-core-boot</module>
        <module>food-media-boot</module>
        <module>food-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- 3.5.16 predates the 2026-08 Tomcat fixes; keep the override until the next BOM upgrade. -->
        <tomcat.version>10.1.59</tomcat.version>
        <!-- Version families kept aligned through their BOMs; September artifact audit. -->
        <jackson-bom.version>2.21.5</jackson-bom.version>
        <netty.version>4.1.137.Final</netty.version>
        <log4j2.version>2.25.5</log4j2.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
    </properties>

    <dependencyManagement>
        <dependencies>
<dependency><groupId>com.dayan</groupId><artifactId>food-platform</artifactId><version>${project.version}</version></dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>food-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>food-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>food-catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>food-achievement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>food-community</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>food-media</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>food-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>food-boot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>3.0.4</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>5.5.1</version>
            </dependency>
            <dependency>
                <groupId>net.coobird</groupId>
                <artifactId>thumbnailator</artifactId>
                <version>0.4.21</version>
            </dependency>
            <dependency>
                <groupId>com.twelvemonkeys.imageio</groupId>
                <artifactId>imageio-webp</artifactId>
                <version>3.15.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Focused -Dtest runs traverse library modules before food-boot. -->
                        <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
